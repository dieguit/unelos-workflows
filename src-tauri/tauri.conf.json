{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unelos-app",
  "version": "0.1.0",
  "identifier": "com.dieguit.unelos-app",
  "build": {
    "beforeDevCommand": "sh scripts/build-sidecar.sh && pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "sh scripts/build-sidecar.sh --release && pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "unelos-app",
        "width": 1400,
        "height": 918,
        "minWidth": 1100,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": ["binaries/unelos"],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
